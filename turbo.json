{
  "$schema": "https://turborepo.com/schema.json",
  "envMode": "strict",
  "ui": "tui",
  "globalPassThroughEnv": [
    "DATABASE_URL",
    "MONGO_URL",
    "MONGO_MAX_IDLE_TIME_MS",
    "MONGO_MAX_POOL_SIZE",
    "MONGO_SERVER_SELECTION_TIMEOUT_MS",
    "MONGO_WAIT_QUEUE_TIMEOUT_MS",
    "KAFKA_BROKERS",
    "KAFKA_CONNECTION_TIMEOUT_MS",
    "KAFKA_LOG_LEVEL",
    "KAFKA_REQUEST_TIMEOUT_MS",
    "KAFKA_TOPIC_MIN_INSYNC_REPLICAS",
    "KAFKA_TOPIC_NUM_PARTITIONS",
    "KAFKA_TOPIC_REPLICATION_FACTOR",
    "KAFKA_UI_URL",
    "DOCKER_DATABASE_URL",
    "DOCKER_MONGO_URL",
    "DOCKER_KAFKA_BROKERS",
    "ADMIN_APP_URL",
    "PRODUCT_SERVICE_INTERNAL_URL",
    "ORDER_SERVICE_INTERNAL_URL",
    "PAYMENT_SERVICE_INTERNAL_URL",
    "NEXT_PUBLIC_ADMIN_APP_URL",
    "NEXT_PUBLIC_CLIENT_APP_URL",
    "NEXT_PUBLIC_PRODUCT_SERVICE_URL",
    "NEXT_PUBLIC_ORDER_SERVICE_URL",
    "NEXT_PUBLIC_PAYMENT_SERVICE_URL",
    "CLERK_PUBLISHABLE_KEY",
    "NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY",
    "CLERK_SECRET_KEY",
    "NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY",
    "STRIPE_SECRET_KEY",
    "STRIPE_WEBHOOK_SECRET",
    "STRIPE_WEBHOOK_SECRET_FILE",
    "PORT",
    "CLIENT_APP_URL",
    "CORS_ALLOWED_ORIGINS"
  ],
  "tasks": {
    "//#lint": {},
    "//#lint:ci": {},
    "//#lint:fix": {
      "cache": false
    },
    "//#knip": {
      "cache": false
    },
    "build": {
      "dependsOn": ["^build", "^db:generate"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**"],
      "env": [
        "ADMIN_APP_URL",
        "CLIENT_APP_URL",
        "NEXT_PUBLIC_*",
        "ORDER_SERVICE_INTERNAL_URL",
        "PAYMENT_SERVICE_INTERNAL_URL",
        "PRODUCT_SERVICE_INTERNAL_URL"
      ]
    },
    "check-types": {
      "dependsOn": ["^check-types", "^db:generate"]
    },
    "dev": {
      "dependsOn": ["^db:generate"],
      "cache": false,
      "persistent": true
    },
    "db:generate": {
      "inputs": ["$TURBO_DEFAULT$", "prisma/schema.prisma", "prisma.config.ts"],
      "outputs": ["generated/**"]
    },
    "db:migrate": {
      "cache": false,
      "persistent": true
    },
    "db:deploy": {
      "cache": false
    }
  }
}
