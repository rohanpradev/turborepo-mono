{
  "$schema": "https://turborepo.dev/schema.json",
  "envMode": "strict",
  "ui": "tui",
  "futureFlags": {
    "affectedUsingTaskInputs": true,
    "longerSignatureKey": true
  },
  "remoteCache": {
    "signature": true
  },
  "boundaries": {
    "tags": {
      "app:web": {
        "dependencies": {
          "deny": [
            "data:product",
            "data:order",
            "infra:kafka",
            "service:product",
            "service:order",
            "service:payment",
            "shared:runtime"
          ]
        }
      },
      "service:product": {
        "dependencies": {
          "deny": ["data:order", "service:order", "service:payment"]
        }
      },
      "service:order": {
        "dependencies": {
          "deny": ["data:product", "service:product", "service:payment"]
        }
      },
      "service:payment": {
        "dependencies": {
          "deny": [
            "data:product",
            "data:order",
            "service:product",
            "service:order"
          ]
        }
      },
      "data:product": {
        "dependents": {
          "deny": ["app:web", "service:order", "service:payment", "data:order"]
        }
      },
      "data:order": {
        "dependents": {
          "deny": [
            "app:web",
            "service:product",
            "service:payment",
            "data:product"
          ]
        }
      },
      "infra:kafka": {
        "dependents": {
          "deny": ["app:web"]
        }
      },
      "shared:runtime": {
        "dependents": {
          "deny": ["app:web"]
        }
      }
    }
  },
  "globalPassThroughEnv": [
    "DATABASE_URL",
    "POSTGRES_CONNECTION_TIMEOUT_MS",
    "POSTGRES_IDLE_TIMEOUT_MS",
    "POSTGRES_POOL_MAX",
    "MONGO_URL",
    "MONGO_MAX_IDLE_TIME_MS",
    "MONGO_MAX_POOL_SIZE",
    "MONGO_SERVER_SELECTION_TIMEOUT_MS",
    "MONGO_WAIT_QUEUE_TIMEOUT_MS",
    "KAFKA_BROKERS",
    "KAFKA_CONNECTION_TIMEOUT_MS",
    "KAFKA_LOG_LEVEL",
    "KAFKA_REQUEST_TIMEOUT_MS",
    "KAFKA_TOPIC_MIN_INSYNC_REPLICAS",
    "KAFKA_TOPIC_NUM_PARTITIONS",
    "KAFKA_TOPIC_REPLICATION_FACTOR",
    "KAFKA_UI_URL",
    "NEXT_IMAGE_ALLOW_LOCAL_IP",
    "REQUEST_TIMEOUT_MS",
    "TELEMETRY_ENABLED",
    "TELEMETRY_LOG_FORMAT",
    "PROMETHEUS_METRICS_ENABLED",
    "PROMETHEUS_METRICS_PATH",
    "DOCKER_DATABASE_URL",
    "DOCKER_MONGO_URL",
    "DOCKER_KAFKA_BROKERS",
    "ADMIN_APP_URL",
    "PRODUCT_SERVICE_INTERNAL_URL",
    "ORDER_SERVICE_INTERNAL_URL",
    "PAYMENT_SERVICE_INTERNAL_URL",
    "NEXT_PUBLIC_ADMIN_APP_URL",
    "NEXT_PUBLIC_CLIENT_APP_URL",
    "NEXT_PUBLIC_PRODUCT_SERVICE_URL",
    "NEXT_PUBLIC_ORDER_SERVICE_URL",
    "NEXT_PUBLIC_PAYMENT_SERVICE_URL",
    "CLERK_PUBLISHABLE_KEY",
    "NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY",
    "CLERK_SECRET_KEY",
    "CLERK_JWT_KEY",
    "CLERK_AUTHORIZED_PARTIES",
    "ADMIN_USER_IDS",
    "NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY",
    "STRIPE_SECRET_KEY",
    "STRIPE_WEBHOOK_SECRET",
    "STRIPE_WEBHOOK_SECRET_FILE",
    "PORT",
    "CLIENT_APP_URL",
    "CORS_ALLOWED_ORIGINS"
  ],
  "tasks": {
    "//#lint": {},
    "//#lint:ci": {},
    "//#lint:fix": {
      "cache": false
    },
    "//#knip": {
      "cache": false
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "dependsOn": ["^db:generate"],
      "cache": false,
      "persistent": true
    },
    "db:generate": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "prisma/schema.prisma",
        "prisma8/contract.prisma",
        "prisma.config.ts",
        "prisma7.config.ts"
      ],
      "outputs": ["generated/**"]
    },
    "db:validate": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "prisma/schema.prisma",
        "prisma8/contract.prisma",
        "prisma.config.ts",
        "prisma7.config.ts"
      ]
    },
    "db:migrate": {
      "cache": false,
      "persistent": true
    },
    "db:deploy": {
      "cache": false
    }
  }
}
