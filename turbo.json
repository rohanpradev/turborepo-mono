{
  "$schema": "https://turborepo.dev/schema.json",
  "envMode": "strict",
  "ui": "tui",
  "futureFlags": {
    "affectedUsingTaskInputs": true,
    "longerSignatureKey": true,
    "strictTaskEntrypointSelection": true
  },
  "remoteCache": {
    "signature": true
  },
  "boundaries": {
    "tags": {
      "app:web": {
        "dependencies": {
          "deny": [
            "data:product",
            "data:order",
            "infra:kafka",
            "service:product",
            "service:order",
            "service:payment",
            "shared:runtime"
          ]
        }
      },
      "service:product": {
        "dependencies": {
          "deny": ["data:order", "service:order", "service:payment"]
        }
      },
      "service:order": {
        "dependencies": {
          "deny": ["data:product", "service:product", "service:payment"]
        }
      },
      "service:payment": {
        "dependencies": {
          "deny": [
            "data:product",
            "data:order",
            "service:product",
            "service:order"
          ]
        }
      },
      "data:product": {
        "dependents": {
          "deny": ["app:web", "service:order", "service:payment", "data:order"]
        }
      },
      "data:order": {
        "dependents": {
          "deny": [
            "app:web",
            "service:product",
            "service:payment",
            "data:product"
          ]
        }
      },
      "infra:kafka": {
        "dependents": {
          "deny": ["app:web"]
        }
      },
      "shared:runtime": {
        "dependents": {
          "deny": ["app:web"]
        }
      }
    }
  },
  "tasks": {
    "//#lint": {},
    "//#lint:ci": {},
    "//#lint:fix": {
      "cache": false
    },
    "//#knip": {
      "cache": false
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "outputLogs": "new-only"
    },
    "check-types": {
      "dependsOn": ["typecheck-deps"],
      "outputLogs": "new-only"
    },
    "dev": {
      "dependsOn": ["^db:generate"],
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "ADMIN_APP_URL",
        "ADMIN_USER_IDS",
        "CLIENT_APP_URL",
        "CLERK_AUTHORIZED_PARTIES",
        "CLERK_JWT_KEY",
        "CLERK_PUBLISHABLE_KEY",
        "CLERK_SECRET_KEY",
        "CORS_ALLOWED_ORIGINS",
        "DATABASE_URL",
        "DOCKER_DATABASE_URL",
        "DOCKER_KAFKA_BROKERS",
        "DOCKER_MONGO_URL",
        "HTTP_IDLE_TIMEOUT_SECONDS",
        "KAFKA_BROKERS",
        "KAFKA_CONNECTION_TIMEOUT_MS",
        "KAFKA_LOG_LEVEL",
        "KAFKA_REQUEST_TIMEOUT_MS",
        "KAFKA_TOPIC_MIN_INSYNC_REPLICAS",
        "KAFKA_TOPIC_NUM_PARTITIONS",
        "KAFKA_TOPIC_REPLICATION_FACTOR",
        "KAFKA_UI_URL",
        "MONGO_MAX_IDLE_TIME_MS",
        "MONGO_MAX_POOL_SIZE",
        "MONGO_SERVER_SELECTION_TIMEOUT_MS",
        "MONGO_URL",
        "MONGO_WAIT_QUEUE_TIMEOUT_MS",
        "NEXT_DEPLOYMENT_ID",
        "NEXT_IMAGE_ALLOW_LOCAL_IP",
        "NEXT_IMAGE_STOREFRONT_ORIGIN",
        "NEXT_PUBLIC_ADMIN_APP_URL",
        "NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY",
        "NEXT_PUBLIC_CLIENT_APP_URL",
        "NEXT_PUBLIC_IMAGE_REMOTE_HOSTS",
        "NEXT_PUBLIC_ORDER_SERVICE_URL",
        "NEXT_PUBLIC_PAYMENT_SERVICE_URL",
        "NEXT_PUBLIC_PRODUCT_SERVICE_URL",
        "NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY",
        "ORDER_SERVICE_INTERNAL_URL",
        "PAYMENT_SERVICE_INTERNAL_URL",
        "PORT",
        "POSTGRES_CONNECTION_TIMEOUT_MS",
        "POSTGRES_IDLE_TIMEOUT_MS",
        "POSTGRES_POOL_MAX",
        "PRODUCT_SERVICE_INTERNAL_URL",
        "PROMETHEUS_METRICS_ENABLED",
        "PROMETHEUS_METRICS_PATH",
        "REQUEST_TIMEOUT_MS",
        "STOREFRONT_ASSET_ORIGIN",
        "STRIPE_SECRET_KEY",
        "STRIPE_WEBHOOK_SECRET",
        "STRIPE_WEBHOOK_SECRET_FILE",
        "TELEMETRY_ENABLED",
        "TELEMETRY_LOG_FORMAT"
      ]
    },
    "db:generate": {
      "inputs": ["$TURBO_DEFAULT$", "src/contract.prisma", "prisma.config.ts"],
      "outputs": ["src/contract.json", "src/contract.d.ts"],
      "outputLogs": "new-only",
      "passThroughEnv": ["DATABASE_URL"]
    },
    "db:validate": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "migrations/**",
        "src/contract.prisma",
        "prisma.config.ts"
      ],
      "outputs": ["src/contract.json", "src/contract.d.ts"],
      "outputLogs": "new-only",
      "passThroughEnv": ["DATABASE_URL"]
    },
    "db:migrate": {
      "cache": false,
      "passThroughEnv": ["DATABASE_URL"]
    },
    "db:plan": {
      "cache": false,
      "passThroughEnv": ["DATABASE_URL"]
    },
    "db:deploy": {
      "cache": false,
      "passThroughEnv": ["DATABASE_URL", "MONGO_URL"]
    },
    "typecheck-deps": {
      "dependsOn": ["^typecheck-deps", "^db:generate"]
    },
    "//#test:integration": {
      "cache": false,
      "passThroughEnv": ["INTEGRATION_DATABASE_URL", "INTEGRATION_MONGO_URL"]
    }
  }
}
