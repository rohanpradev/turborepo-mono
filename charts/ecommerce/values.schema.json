{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "global": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "imageRegistry": { "type": "string" },
        "imagePullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        },
        "enableServiceLinks": { "type": "boolean" },
        "terminationGracePeriodSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "podSecurityContext": { "type": "object" },
        "containerSecurityContext": { "type": "object" },
        "env": {
          "type": "object",
          "additionalProperties": {
            "type": ["string", "number", "boolean"]
          }
        },
        "tmp": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "sizeLimit": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "create": { "type": "boolean" },
        "automountServiceAccountToken": { "type": "boolean" },
        "name": { "type": "string" }
      }
    },
    "stripeCli": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "forwardTo": { "type": "string", "minLength": 1 },
        "webhookSecretFile": { "type": "string", "pattern": "^/" },
        "events": { "type": "string", "minLength": 1 },
        "image": {
          "type": "object",
          "required": ["repository", "tag", "pullPolicy"],
          "properties": {
            "repository": { "type": "string", "minLength": 1 },
            "tag": { "type": "string", "minLength": 1 },
            "digest": {
              "type": "string",
              "pattern": "^(|sha256:[a-f0-9]{64})$"
            },
            "pullPolicy": {
              "type": "string",
              "enum": ["Always", "IfNotPresent", "Never"]
            }
          }
        },
        "resources": { "type": "object" }
      }
    },
    "secrets": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string" },
        "stringData": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string" },
        "tls": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "enabled": { "type": "boolean" },
            "secretName": { "type": "string" }
          }
        },
        "hosts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["host", "paths"],
            "properties": {
              "host": { "type": "string", "minLength": 1 },
              "paths": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["path", "pathType", "service", "port"],
                  "properties": {
                    "path": { "type": "string", "minLength": 1 },
                    "pathType": {
                      "type": "string",
                      "enum": ["Exact", "Prefix", "ImplementationSpecific"]
                    },
                    "service": {
                      "type": "string",
                      "enum": ["client", "admin", "product", "order", "payment"]
                    },
                    "port": { "type": ["string", "integer"] }
                  }
                }
              }
            }
          }
        }
      }
    },
    "gateway": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "create": { "type": "boolean" },
        "name": { "type": "string", "minLength": 1 },
        "namespace": { "type": "string" },
        "gatewayClassName": { "type": "string", "minLength": 1 },
        "sectionName": { "type": "string" },
        "annotations": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "labels": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "listeners": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "port", "protocol"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "hostname": { "type": "string" },
              "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
              "protocol": {
                "type": "string",
                "enum": ["HTTP", "HTTPS", "TLS", "TCP", "UDP"]
              },
              "tls": { "type": "object" }
            }
          }
        }
      }
    },
    "observability": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "serviceMonitor": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "enabled": { "type": "boolean" },
            "labels": {
              "type": "object",
              "additionalProperties": { "type": "string" }
            },
            "interval": { "type": "string", "minLength": 1 },
            "scrapeTimeout": { "type": "string", "minLength": 1 },
            "path": { "type": "string", "pattern": "^/" },
            "jobLabel": { "type": "string", "minLength": 1 },
            "services": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": ["product", "order", "payment", "client", "admin"]
              }
            },
            "metricRelabelings": { "type": "array" },
            "relabelings": { "type": "array" }
          }
        },
        "traefik": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "namespace": { "type": "string", "minLength": 1 },
            "serviceMonitor": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "enabled": { "type": "boolean" },
                "labels": {
                  "type": "object",
                  "additionalProperties": { "type": "string" }
                },
                "interval": { "type": "string", "minLength": 1 },
                "scrapeTimeout": { "type": "string", "minLength": 1 },
                "path": { "type": "string", "pattern": "^/" },
                "port": { "type": "string", "minLength": 1 },
                "selector": {
                  "type": "object",
                  "additionalProperties": { "type": "string" }
                }
              }
            }
          }
        },
        "prometheusRule": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "enabled": { "type": "boolean" },
            "labels": {
              "type": "object",
              "additionalProperties": { "type": "string" }
            },
            "thresholds": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "errorRatio": { "type": "number", "minimum": 0 },
                "p95LatencySeconds": { "type": "number", "minimum": 0 },
                "traefikErrorRatio": { "type": "number", "minimum": 0 }
              }
            }
          }
        },
        "grafanaDashboard": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "enabled": { "type": "boolean" },
            "labels": {
              "type": "object",
              "additionalProperties": { "type": "string" }
            },
            "annotations": {
              "type": "object",
              "additionalProperties": { "type": "string" }
            }
          }
        }
      }
    },
    "services": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "enabled": { "type": "boolean" },
          "name": { "type": "string", "minLength": 1 },
          "replicaCount": { "type": "integer", "minimum": 0 },
          "revisionHistoryLimit": { "type": "integer", "minimum": 0 },
          "containerPort": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "image": {
            "type": "object",
            "required": ["repository"],
            "properties": {
              "repository": { "type": "string", "minLength": 1 },
              "tag": { "type": "string" },
              "digest": {
                "type": "string",
                "pattern": "^(|sha256:[a-f0-9]{64})$"
              },
              "pullPolicy": {
                "type": "string",
                "enum": ["", "Always", "IfNotPresent", "Never"]
              }
            }
          },
          "service": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": ["ClusterIP", "NodePort", "LoadBalancer"]
              },
              "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
            }
          },
          "resources": { "type": "object" },
          "autoscaling": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "enabled": { "type": "boolean" },
              "minReplicas": { "type": "integer", "minimum": 1 },
              "maxReplicas": { "type": "integer", "minimum": 1 },
              "targetCPUUtilizationPercentage": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100
              }
            }
          },
          "rollout": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "minReadySeconds": { "type": "integer", "minimum": 0 },
              "progressDeadlineSeconds": { "type": "integer", "minimum": 1 }
            }
          },
          "podDisruptionBudget": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "enabled": { "type": "boolean" },
              "unhealthyPodEvictionPolicy": {
                "type": "string",
                "enum": ["AlwaysAllow", "IfHealthyBudget"]
              },
              "minAvailable": { "type": ["integer", "string"] },
              "maxUnavailable": { "type": ["integer", "string"] }
            }
          }
        }
      }
    },
    "jobs": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "enabled": { "type": "boolean" },
          "service": {
            "type": "string",
            "enum": ["client", "admin", "product", "order", "payment"]
          },
          "command": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          },
          "backoffLimit": { "type": "integer", "minimum": 0 },
          "ttlSecondsAfterFinished": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "allowExternalEgress": { "type": "boolean" },
        "allowDnsEgress": { "type": "boolean" },
        "ingressFrom": { "type": "array" },
        "extraEgress": { "type": "array" }
      }
    },
    "helmTests": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "image": {
          "type": "object",
          "required": ["repository", "tag", "pullPolicy"],
          "properties": {
            "repository": { "type": "string", "minLength": 1 },
            "tag": { "type": "string", "minLength": 1 },
            "digest": {
              "type": "string",
              "pattern": "^(|sha256:[a-f0-9]{64})$"
            },
            "pullPolicy": {
              "type": "string",
              "enum": ["Always", "IfNotPresent", "Never"]
            }
          }
        }
      }
    }
  }
}
