{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "global": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "imageRegistry": { "type": "string" },
        "imagePullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        },
        "env": {
          "type": "object",
          "additionalProperties": {
            "type": ["string", "number", "boolean"]
          }
        },
        "tmp": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "sizeLimit": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "create": { "type": "boolean" },
        "automountServiceAccountToken": { "type": "boolean" },
        "name": { "type": "string" }
      }
    },
    "secrets": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string" },
        "stringData": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string" },
        "tls": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "enabled": { "type": "boolean" },
            "secretName": { "type": "string" }
          }
        },
        "hosts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["host", "paths"],
            "properties": {
              "host": { "type": "string", "minLength": 1 },
              "paths": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["path", "pathType", "service", "port"],
                  "properties": {
                    "path": { "type": "string", "minLength": 1 },
                    "pathType": {
                      "type": "string",
                      "enum": ["Exact", "Prefix", "ImplementationSpecific"]
                    },
                    "service": {
                      "type": "string",
                      "enum": ["client", "admin", "product", "order", "payment"]
                    },
                    "port": { "type": ["string", "integer"] }
                  }
                }
              }
            }
          }
        }
      }
    },
    "gateway": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "create": { "type": "boolean" },
        "name": { "type": "string", "minLength": 1 },
        "namespace": { "type": "string" },
        "gatewayClassName": { "type": "string", "minLength": 1 },
        "sectionName": { "type": "string" },
        "annotations": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "labels": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "listeners": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "port", "protocol"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "hostname": { "type": "string" },
              "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
              "protocol": {
                "type": "string",
                "enum": ["HTTP", "HTTPS", "TLS", "TCP", "UDP"]
              },
              "tls": { "type": "object" }
            }
          }
        }
      }
    },
    "services": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "enabled": { "type": "boolean" },
          "name": { "type": "string", "minLength": 1 },
          "replicaCount": { "type": "integer", "minimum": 0 },
          "revisionHistoryLimit": { "type": "integer", "minimum": 0 },
          "containerPort": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "image": {
            "type": "object",
            "required": ["repository"],
            "properties": {
              "repository": { "type": "string", "minLength": 1 },
              "tag": { "type": "string" },
              "pullPolicy": {
                "type": "string",
                "enum": ["", "Always", "IfNotPresent", "Never"]
              }
            }
          },
          "service": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": ["ClusterIP", "NodePort", "LoadBalancer"]
              },
              "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
            }
          },
          "resources": { "type": "object" },
          "autoscaling": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "enabled": { "type": "boolean" },
              "minReplicas": { "type": "integer", "minimum": 1 },
              "maxReplicas": { "type": "integer", "minimum": 1 },
              "targetCPUUtilizationPercentage": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100
              }
            }
          },
          "podDisruptionBudget": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "enabled": { "type": "boolean" },
              "minAvailable": { "type": ["integer", "string"] },
              "maxUnavailable": { "type": ["integer", "string"] }
            }
          }
        }
      }
    },
    "jobs": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "enabled": { "type": "boolean" },
          "service": {
            "type": "string",
            "enum": ["client", "admin", "product", "order", "payment"]
          },
          "command": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          },
          "backoffLimit": { "type": "integer", "minimum": 0 },
          "ttlSecondsAfterFinished": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "allowExternalEgress": { "type": "boolean" }
      }
    },
    "helmTests": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" }
      }
    }
  }
}
