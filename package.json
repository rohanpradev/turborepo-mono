{
  "name": "ecommerce",
  "private": true,
  "scripts": {
    "build": "bunx turbo run build",
    "dev": "bunx turbo run dev",
    "dev:setup": "cd packages/product-db && bun run db:generate && cd ../.. && bun dev",
    "lint": "biome check .",
    "lint:ci": "biome ci .",
    "lint:fix": "biome check . --write",
    "format": "biome format . --write",
    "check-types": "bunx turbo run check-types",
    "ci:types-build": "bun run check-types && bun run build",
    "ci:verify": "bun run lint:ci && bun run knip && bun run test:coverage && bun run audit && bun run ci:types-build",
    "audit": "bun audit --audit-level=moderate",
    "test": "bun test --preload ./tests/preload.ts ./tests",
    "test:coverage": "bun test --preload ./tests/preload.ts --coverage --coverage-reporter=text --coverage-reporter=lcov ./tests",
    "verify": "bun run lint && bun run check-types && bun run test && bun run build",
    "knip": "knip --cache"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@types/bun": "^1.3.14",
    "@types/node": "^25.8.0",
    "@typescript/native-preview": "^7.0.0-dev.20260514.1",
    "knip": "^6.13.1",
    "turbo": "^2.9.14"
  },
  "engines": {
    "bun": ">=1.3.14",
    "node": ">=20.19.0"
  },
  "packageManager": "bun@1.3.14",
  "overrides": {
    "@clerk/backend": "^3.4.6",
    "@clerk/shared": "^4.10.1",
    "@hono/node-server": "^1.19.13",
    "defu": "^6.1.5",
    "effect": "^3.21.0",
    "fast-uri": "^3.1.2",
    "hono": "^4.12.18",
    "lodash": "^4.18.1",
    "postcss": "^8.5.14"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
