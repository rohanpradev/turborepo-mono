{
  "name": "ecommerce",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:setup": "cd packages/product-db && bun run db:generate && cd ../.. && bun dev",
    "doctor": "bun run scripts/doctor.ts",
    "lint": "biome check .",
    "lint:ci": "biome ci .",
    "lint:fix": "biome check . --write",
    "format": "biome format . --write",
    "check:parallel": "bun run --parallel lint:ci deps:check deps:dedupe:check db:validate knip boundaries test",
    "check-types": "turbo run check-types",
    "db:validate": "turbo run db:validate",
    "ci:types-build": "turbo run check-types build --summarize",
    "ci:verify": "bun run lint:ci && bun run deps:check && bun run deps:dedupe:check && bun run db:validate && bun run knip && bun run boundaries && bun run test:coverage && bun run audit && bun run ci:types-build",
    "audit": "bun audit --audit-level=moderate",
    "test": "bun test --parallel --preload ./tests/preload.ts ./tests",
    "test:changed": "bun test --changed --preload ./tests/preload.ts ./tests",
    "test:coverage": "bun test --parallel --preload ./tests/preload.ts --coverage --coverage-reporter=text --coverage-reporter=lcov ./tests",
    "verify": "bun run lint && bun run db:validate && bun run check-types && bun run test && bun run build",
    "verify:docker": "make docker-validate",
    "verify:full": "bun run doctor && bun run deps:check && bun run deps:dedupe:check && bun run db:validate && bun run lint && bun run knip && bun run test && bun run check-types && bun run build && bun run verify:docker",
    "knip": "knip --cache",
    "boundaries": "turbo boundaries",
    "turbo:summary": "turbo run check-types build --summarize",
    "turbo:graph": "turbo run check-types build --graph=docs/task-graph.mermaid",
    "turbo:report": "bun run scripts/turbo-report.ts",
    "turbo:inspect": "bun run turbo:summary && bun run turbo:graph && bun run turbo:report",
    "deps:check": "syncpack lint",
    "deps:fix": "syncpack fix",
    "deps:dedupe": "bun dedupe",
    "deps:dedupe:check": "bun dedupe --check",
    "deps:licenses": "bun pm licenses --prod",
    "audit:fix": "bun audit fix --dry-run",
    "deps:outdated": "bun outdated --recursive"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "knip": "^6.33.0",
    "syncpack": "^15.3.3",
    "turbo": "^2.10.12"
  },
  "engines": {
    "bun": ">=1.4.0",
    "node": ">=20.19.0"
  },
  "packageManager": "bun@1.4.0",
  "overrides": {
    "@clerk/backend": "^3.16.10",
    "@clerk/shared": "^4.27.1",
    "@hono/node-server": "^2.1.0",
    "defu": "^6.1.7",
    "deepmerge-ts": "^8.0.2",
    "effect": "^3.22.1",
    "fast-uri": "^4.1.2",
    "find-my-way": "^9.7.0",
    "hono": "^4.13.5",
    "lodash": "^4.18.1",
    "postcss": "^8.5.26",
    "sharp": "^0.35.3",
    "valibot": "^1.4.2"
  },
  "catalog": {
    "@clerk/backend": "^3.16.13",
    "@clerk/hono": "^0.1.74",
    "@clerk/nextjs": "^7.8.3",
    "@hono/zod-openapi": "^1.6.1",
    "@hookform/resolvers": "^5.9.1",
    "@orpc/client": "^1.15.0",
    "@orpc/contract": "^1.15.0",
    "@orpc/server": "^1.15.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@prisma/orm-postgres": "^8.0.0-rc.8",
    "@prisma/prisma7": "^7.10.0",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@scalar/hono-api-reference": "^0.12.0",
    "@stripe/react-stripe-js": "^6.8.2",
    "@stripe/stripe-js": "^9.14.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bun": "^1.4.0",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "babel-plugin-react-compiler": "^1.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hono": "^4.13.5",
    "kafkajs": "^2.2.4",
    "lucide-react": "^1.37.0",
    "mongoose": "^9.9.4",
    "next": "^16.3.3",
    "pg": "^8.23.0",
    "postcss": "^8.5.26",
    "prisma": "^8.0.0-rc.12",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.87.0",
    "sonner": "^2.0.8",
    "stripe": "^22.6.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "zod": "^4.5.4",
    "zustand": "^5.0.15"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {},
  "patchedDependencies": {
    "kafkajs@2.2.4": "patches/kafkajs@2.2.4.patch"
  }
}
