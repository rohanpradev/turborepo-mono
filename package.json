{
  "name": "ecommerce",
  "private": true,
  "scripts": {
    "build": "turbo run build --concurrency=1",
    "dev": "turbo run dev",
    "dev:setup": "bun run dev",
    "doctor": "bun run scripts/doctor.ts",
    "helm:assert-profiles": "bun run scripts/helm-profile-policy.ts",
    "lint": "biome check .",
    "lint:ci": "biome ci .",
    "lint:fix": "biome check . --write",
    "format": "biome format . --write",
    "check:parallel": "bun run --parallel lint:ci deps:check deps:dedupe:check db:validate knip boundaries test",
    "check-types": "turbo run check-types //#check-tools",
    "db:validate": "turbo run db:validate",
    "ci:types-build": "turbo run check-types //#check-tools --summarize && turbo run build --concurrency=1 --summarize",
    "ci:verify": "bun run lint:ci && bun run deps:check && bun run deps:dedupe:check && bun run db:validate && bun run knip && bun run boundaries && bun run test:coverage && bun run audit && bun run ci:types-build && bun run test:web",
    "audit": "bun audit --audit-level=moderate",
    "test": "bun test --parallel --preload ./tests/preload.ts ./tests",
    "test:changed": "bun test --changed --preload ./tests/preload.ts ./tests",
    "test:coverage": "bun test --parallel --preload ./tests/preload.ts --coverage --coverage-reporter=text --coverage-reporter=lcov ./tests",
    "verify": "bun run lint && bun run db:validate && bun run check-types && bun run test && bun run build",
    "verify:docker": "make docker-validate",
    "verify:full": "bun run doctor && bun run deps:check && bun run deps:dedupe:check && bun run db:validate && bun run lint && bun run knip && bun run test && bun run check-types && bun run build && bun run verify:docker",
    "knip": "knip --cache --treat-config-hints-as-errors && knip --cache --production --strict --treat-config-hints-as-errors",
    "boundaries": "turbo boundaries",
    "turbo:summary": "turbo run check-types //#check-tools --summarize && turbo run build --concurrency=1 --summarize",
    "turbo:graph": "turbo run check-types //#check-tools build --graph=docs/task-graph.mermaid",
    "turbo:report": "bun run scripts/turbo-report.ts",
    "turbo:inspect": "bun run turbo:summary && bun run turbo:graph && bun run turbo:report",
    "deps:check": "syncpack lint",
    "deps:fix": "syncpack fix",
    "deps:update": "bun update --interactive --recursive",
    "deps:dedupe": "bun dedupe",
    "deps:dedupe:check": "bun dedupe --check",
    "deps:licenses": "bun pm licenses --prod",
    "audit:fix": "bun audit fix --dry-run",
    "deps:outdated": "bun outdated --recursive",
    "test:integration": "bun run scripts/test-integration.ts",
    "test:web": "bun run scripts/test-web-smoke.ts",
    "check-tools": "tsc --project scripts/tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "knip": "^6.38.0",
    "syncpack": "^15.3.3",
    "turbo": "^2.11.4",
    "undici-types": "^8.11.2"
  },
  "engines": {
    "bun": ">=1.4.2",
    "node": ">=24.0.0"
  },
  "packageManager": "bun@1.4.2",
  "overrides": {
    "@clerk/backend": "^3.20.1",
    "@clerk/shared": "^4.36.0",
    "@hono/node-server": "^2.1.1",
    "@types/pg": "8.23.1",
    "deepmerge-ts": "^8.0.2",
    "defu": "^6.1.7",
    "fast-uri": "^4.2.1",
    "find-my-way": "^9.9.0",
    "hono": "^4.13.9",
    "lodash": "^4.18.1",
    "postcss": "^8.5.28",
    "sharp": "^0.35.4",
    "valibot": "^1.5.0"
  },
  "catalog": {
    "@clerk/backend": "^3.20.1",
    "@clerk/hono": "^0.1.82",
    "@clerk/nextjs": "^7.9.7",
    "@hono/zod-openapi": "^1.6.3",
    "@orpc/client": "^1.15.4",
    "@orpc/contract": "^1.15.4",
    "@orpc/server": "^1.15.4",
    "@prisma/orm-postgres": "8.0.0-rc.12",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@scalar/hono-api-reference": "^0.12.6",
    "@stripe/react-stripe-js": "^6.12.0",
    "@stripe/stripe-js": "^9.17.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.3",
    "@types/pg": "8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hono": "^4.13.9",
    "kafkajs": "^2.2.4",
    "lucide-react": "^1.48.0",
    "mongoose": "^9.10.2",
    "next": "^16.3.6",
    "pg": "^8.23.0",
    "postcss": "^8.5.28",
    "prisma": "8.0.0-rc.17",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sonner": "^2.0.8",
    "stripe": "^22.6.2",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "zod": "^4.6.5",
    "zustand": "^5.0.15",
    "radix-ui": "^1.6.7",
    "server-only": "^0.0.1"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {},
  "patchedDependencies": {
    "kafkajs@2.2.4": "patches/kafkajs@2.2.4.patch"
  }
}
