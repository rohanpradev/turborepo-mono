{
  "name": "ecommerce",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:setup": "cd packages/product-db && bun run db:generate && cd ../.. && bun dev",
    "doctor": "bun run scripts/doctor.ts",
    "lint": "biome check .",
    "lint:ci": "biome ci .",
    "lint:fix": "biome check . --write",
    "format": "biome format . --write",
    "check-types": "turbo run check-types",
    "ci:types-build": "turbo run check-types build --summarize",
    "ci:verify": "bun run lint:ci && bun run deps:check && bun run knip && bun run boundaries && bun run test:coverage && bun run audit && bun run ci:types-build",
    "audit": "bun audit --audit-level=moderate",
    "test": "bun test --preload ./tests/preload.ts ./tests",
    "test:coverage": "bun test --preload ./tests/preload.ts --coverage --coverage-reporter=text --coverage-reporter=lcov ./tests",
    "verify": "bun run lint && bun run check-types && bun run test && bun run build",
    "verify:docker": "make docker-validate",
    "verify:full": "bun run doctor && bun run deps:check && bun run lint && bun run knip && bun run test && bun run check-types && bun run build && bun run verify:docker",
    "knip": "knip --cache",
    "boundaries": "turbo boundaries",
    "turbo:summary": "turbo run check-types build --summarize",
    "turbo:graph": "turbo run check-types build --graph=docs/task-graph.mermaid",
    "turbo:report": "bun run scripts/turbo-report.ts",
    "turbo:inspect": "bun run turbo:summary && bun run turbo:graph && bun run turbo:report",
    "deps:check": "syncpack lint",
    "deps:fix": "syncpack fix",
    "deps:outdated": "bun outdated --recursive"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.1.2",
    "typescript": "^7.0.2",
    "knip": "^6.30.0",
    "syncpack": "^15.3.2",
    "turbo": "^2.10.7"
  },
  "engines": {
    "bun": ">=1.3.14",
    "node": ">=20.19.0"
  },
  "packageManager": "bun@1.3.14",
  "overrides": {
    "@clerk/backend": "^3.14.0",
    "@clerk/shared": "^4.25.8",
    "@hono/node-server": "^2.0.6",
    "defu": "^6.1.7",
    "effect": "^3.21.4",
    "fast-uri": "^4.1.1",
    "find-my-way": "^9.7.0",
    "hono": "^4.12.33",
    "lodash": "^4.18.1",
    "postcss": "^8.5.25",
    "sharp": "^0.35.3",
    "valibot": "^1.4.2"
  },
  "catalog": {
    "@clerk/backend": "^3.14.0",
    "@clerk/nextjs": "^7.6.3",
    "@clerk/hono": "^0.1.58",
    "@hono/zod-openapi": "^1.5.1",
    "@hookform/resolvers": "^5.5.7",
    "@orpc/client": "^1.14.13",
    "@orpc/contract": "^1.14.13",
    "@orpc/server": "^1.14.13",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@scalar/hono-api-reference": "^0.11.12",
    "@stripe/react-stripe-js": "^6.8.0",
    "@stripe/stripe-js": "^9.12.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hono": "^4.12.33",
    "kafkajs": "^2.2.4",
    "lucide-react": "^1.28.0",
    "mongoose": "^9.9.0",
    "next": "^16.2.12",
    "pg": "^8.22.0",
    "postcss": "^8.5.25",
    "prisma": "^7.9.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.83.0",
    "sonner": "^2.0.7",
    "stripe": "^22.4.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {},
  "patchedDependencies": {
    "kafkajs@2.2.4": "patches/kafkajs@2.2.4.patch"
  }
}
