{
  "name": "ecommerce",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:setup": "cd packages/product-db && bun run db:generate && cd ../.. && bun dev",
    "doctor": "bun run scripts/doctor.ts",
    "lint": "biome check .",
    "lint:ci": "biome ci .",
    "lint:fix": "biome check . --write",
    "format": "biome format . --write",
    "check-types": "turbo run check-types",
    "ci:types-build": "turbo run check-types build --summarize",
    "ci:verify": "bun run lint:ci && bun run deps:check && bun run knip && bun run boundaries && bun run test:coverage && bun run audit && bun run ci:types-build",
    "audit": "bun audit --audit-level=moderate",
    "test": "bun test --preload ./tests/preload.ts ./tests",
    "test:coverage": "bun test --preload ./tests/preload.ts --coverage --coverage-reporter=text --coverage-reporter=lcov ./tests",
    "verify": "bun run lint && bun run check-types && bun run test && bun run build",
    "verify:docker": "make docker-validate",
    "verify:full": "bun run doctor && bun run deps:check && bun run lint && bun run knip && bun run test && bun run check-types && bun run build && bun run verify:docker",
    "knip": "knip --cache",
    "boundaries": "turbo boundaries",
    "turbo:summary": "turbo run check-types build --summarize",
    "turbo:graph": "turbo run check-types build --graph=docs/task-graph.mermaid",
    "turbo:report": "bun run scripts/turbo-report.ts",
    "turbo:inspect": "bun run turbo:summary && bun run turbo:graph && bun run turbo:report",
    "deps:check": "syncpack lint",
    "deps:fix": "syncpack fix",
    "deps:outdated": "bun outdated --recursive"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.3",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "knip": "^6.26.0",
    "syncpack": "^15.3.2",
    "turbo": "^2.10.4"
  },
  "engines": {
    "bun": ">=1.3.14",
    "node": ">=20.19.0"
  },
  "packageManager": "bun@1.3.14",
  "overrides": {
    "@clerk/backend": "^3.11.4",
    "@clerk/shared": "^4.22.0",
    "@hono/node-server": "^2.0.6",
    "defu": "^6.1.7",
    "effect": "^3.21.4",
    "fast-uri": "^4.0.0",
    "hono": "^4.12.29",
    "lodash": "^4.18.1",
    "postcss": "^8.5.17"
  },
  "catalog": {
    "@clerk/backend": "^3.11.4",
    "@clerk/nextjs": "^7.5.17",
    "@clerk/hono": "^0.1.50",
    "@hono/zod-openapi": "^1.4.0",
    "@hookform/resolvers": "^5.4.0",
    "@orpc/client": "^1.14.7",
    "@orpc/contract": "^1.14.7",
    "@orpc/server": "^1.14.7",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@radix-ui/react-avatar": "^1.2.2",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-separator": "^1.1.11",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-tooltip": "^1.2.12",
    "@scalar/hono-api-reference": "^0.11.9",
    "@stripe/react-stripe-js": "^6.7.0",
    "@stripe/stripe-js": "^9.9.0",
    "@tailwindcss/postcss": "^4.3.2",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hono": "^4.12.29",
    "kafkajs": "^2.2.4",
    "lucide-react": "^1.24.0",
    "mongoose": "^9.7.4",
    "next": "^16.2.10",
    "pg": "^8.22.0",
    "postcss": "^8.5.17",
    "prisma": "^7.8.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.81.0",
    "react-toastify": "^11.1.0",
    "stripe": "^22.3.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.2",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {},
  "patchedDependencies": {
    "kafkajs@2.2.4": "patches/kafkajs@2.2.4.patch"
  }
}
