{
  "name": "ecommerce",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:setup": "cd packages/product-db && bun run db:generate && cd ../.. && bun dev",
    "doctor": "bun run scripts/doctor.ts",
    "lint": "biome check .",
    "lint:ci": "biome ci .",
    "lint:fix": "biome check . --write",
    "format": "biome format . --write",
    "check-types": "turbo run check-types",
    "ci:types-build": "bun run check-types && bun run build",
    "ci:verify": "bun run lint:ci && bun run deps:check && bun run knip && bun run test:coverage && bun run audit && bun run ci:types-build",
    "audit": "bun audit --audit-level=moderate",
    "test": "bun test --preload ./tests/preload.ts ./tests",
    "test:coverage": "bun test --preload ./tests/preload.ts --coverage --coverage-reporter=text --coverage-reporter=lcov ./tests",
    "verify": "bun run lint && bun run check-types && bun run test && bun run build",
    "verify:docker": "make docker-validate",
    "verify:full": "bun run doctor && bun run deps:check && bun run lint && bun run knip && bun run test && bun run check-types && bun run build && bun run verify:docker",
    "knip": "knip --cache",
    "deps:check": "syncpack lint",
    "deps:fix": "syncpack fix",
    "deps:outdated": "bun outdated --recursive"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native-preview": "^7.0.0-dev.20260527.2",
    "knip": "^6.14.2",
    "syncpack": "^15.3.1",
    "turbo": "^2.9.16"
  },
  "engines": {
    "bun": ">=1.3.14",
    "node": ">=20.19.0"
  },
  "packageManager": "bun@1.3.14",
  "overrides": {
    "@clerk/backend": "^3.4.14",
    "@clerk/shared": "^4.13.1",
    "@hono/node-server": "^2.0.3",
    "defu": "^6.1.7",
    "effect": "^3.21.2",
    "fast-uri": "^3.1.2",
    "hono": "^4.12.23",
    "lodash": "^4.18.1",
    "postcss": "^8.5.15"
  },
  "catalog": {
    "@clerk/backend": "^3.4.14",
    "@clerk/nextjs": "^7.4.2",
    "@hono/clerk-auth": "^3.1.1",
    "@hono/zod-openapi": "^1.4.0",
    "@hookform/resolvers": "^5.4.0",
    "@orpc/client": "^1.14.4",
    "@orpc/contract": "^1.14.4",
    "@orpc/server": "^1.14.4",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@scalar/hono-api-reference": "^0.10.19",
    "@stripe/react-stripe-js": "^6.5.0",
    "@stripe/stripe-js": "^9.7.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/bun": "^1.3.14",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hono": "^4.12.23",
    "kafkajs": "^2.2.4",
    "lucide-react": "^1.17.0",
    "mongoose": "^9.6.3",
    "next": "^16.2.6",
    "pg": "^8.21.0",
    "postcss": "^8.5.15",
    "prisma": "^7.8.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-hook-form": "^7.76.1",
    "react-toastify": "^11.1.0",
    "stripe": "^22.2.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
