# syntax=docker/dockerfile:1.26.0@sha256:ecfaec9ed6d810b56388c508f4121597bfbba70d41a6dfeee4d8cad5f295fc32
ARG BUN_DEV_IMAGE=oven/bun:1.4.0@sha256:5ff609364c049b54eb0ff560ec96319729a972078ef2c755d758f0c6ef89c2d6
ARG BUN_RUNTIME_IMAGE=oven/bun:1.4.0@sha256:5ff609364c049b54eb0ff560ec96319729a972078ef2c755d758f0c6ef89c2d6
ARG TURBO_VERSION=2.10.12

FROM ${BUN_DEV_IMAGE} AS pruner
ARG TURBO_VERSION
ENV CI=1 \
    TURBO_TELEMETRY_DISABLED=1
WORKDIR /repo
RUN --mount=type=cache,target=/root/.bun/install/cache,sharing=locked \
    bun install --global turbo@${TURBO_VERSION}
ENV PATH="/root/.bun/bin:$PATH"
COPY --link . .
RUN turbo prune payment-service --docker

FROM ${BUN_DEV_IMAGE} AS builder
ENV CI=1 \
    TURBO_TELEMETRY_DISABLED=1 \
    NODE_ENV=production
WORKDIR /app

COPY --link --from=pruner /repo/out/json/ ./
RUN --mount=type=cache,target=/root/.bun/install/cache,sharing=locked \
    bun install --frozen-lockfile --production --linker=hoisted
COPY --link --from=pruner /repo/out/full/ ./

FROM ${BUN_RUNTIME_IMAGE} AS runner
ENV NODE_ENV=production \
    NODE_PATH=/app/node_modules/.bun/node_modules \
    PORT=8002
WORKDIR /app

COPY --link --from=builder /app/node_modules ./node_modules
COPY --link --from=builder /app/package.json ./package.json
COPY --link --from=builder /app/bun.lock ./bun.lock

COPY --link --from=builder /app/apps/payment-service/package.json ./apps/payment-service/package.json
COPY --link --from=builder /app/apps/payment-service/tsconfig.json ./apps/payment-service/tsconfig.json
COPY --link --from=builder /app/apps/payment-service/src ./apps/payment-service/src

COPY --link --from=builder /app/packages ./packages

USER bun

EXPOSE 8002

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD ["bun", "-e", "fetch('http://127.0.0.1:8002/health/ready').then((response) => { if (!response.ok) process.exit(1); }).catch(() => process.exit(1));"]
STOPSIGNAL SIGTERM

CMD ["bun", "run", "apps/payment-service/src/index.ts"]
