# syntax=docker/dockerfile:1.28.0@sha256:bb22d9815c728170f72750f4e5b0d672e06176142e1d602c7e66c050100b7e5b
ARG BUN_DEV_IMAGE=oven/bun:1.4.4@sha256:1d22548f177f4ff38e0c15baa3c2c46c6c2060ba2d1bc573bb4720b407548f1d
ARG BUN_RUNTIME_IMAGE=oven/bun:1.4.4@sha256:1d22548f177f4ff38e0c15baa3c2c46c6c2060ba2d1bc573bb4720b407548f1d
ARG TURBO_VERSION=2.11.10

FROM ${BUN_DEV_IMAGE} AS pruner
ARG TURBO_VERSION
ENV CI=1 \
    TURBO_TELEMETRY_DISABLED=1
WORKDIR /repo
RUN --mount=type=cache,target=/root/.bun/install/cache,sharing=locked \
    bun install --global turbo@${TURBO_VERSION}
ENV PATH="/root/.bun/bin:$PATH"
COPY --link . .
RUN turbo prune payment-service --docker

FROM ${BUN_DEV_IMAGE} AS prod-deps
ENV CI=1 \
    TURBO_TELEMETRY_DISABLED=1 \
    NODE_ENV=production
WORKDIR /app

COPY --link --from=pruner /repo/out/json/ ./
RUN --mount=type=cache,target=/root/.bun/install/cache,sharing=locked \
    bun install --frozen-lockfile --production --linker=hoisted

FROM ${BUN_DEV_IMAGE} AS builder
ENV CI=1 \
    TURBO_TELEMETRY_DISABLED=1 \
    NODE_ENV=production
WORKDIR /app

COPY --link --from=pruner /repo/out/json/ ./
RUN --mount=type=cache,target=/root/.bun/install/cache,sharing=locked \
    bun install --frozen-lockfile --linker=hoisted
COPY --link --from=pruner /repo/out/full/ ./
RUN bun run --cwd apps/payment-service check-types

FROM ${BUN_RUNTIME_IMAGE} AS runner
ENV NODE_ENV=production \
    BUN_RUNTIME_TRANSPILER_CACHE_PATH=/tmp/bun-transpiler \
    NODE_PATH=/app/node_modules/.bun/node_modules \
    PORT=8002
WORKDIR /app

COPY --link --from=prod-deps /app/node_modules ./node_modules
COPY --link --from=builder /app/package.json ./package.json
COPY --link --from=builder /app/bun.lock ./bun.lock

# Preserve workspace-local production dependencies as well as the root tree.
COPY --link --from=prod-deps /app/apps/payment-service ./apps/payment-service
COPY --link --from=builder /app/apps/payment-service/package.json ./apps/payment-service/package.json
COPY --link --from=builder /app/apps/payment-service/tsconfig.json ./apps/payment-service/tsconfig.json
COPY --link --from=builder /app/apps/payment-service/src ./apps/payment-service/src

# Source comes from the pruned context; dependency links come only from prod-deps.
COPY --link --from=pruner /repo/out/full/packages ./packages
COPY --link --from=prod-deps /app/packages ./packages

USER bun

EXPOSE 8002

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD ["bun", "-e", "fetch('http://127.0.0.1:8002/health/ready', { signal: AbortSignal.timeout(3000), proxy: false }).then((response) => { if (!response.ok) process.exit(1); }).catch(() => process.exit(1));"]
STOPSIGNAL SIGTERM

CMD ["bun", "run", "apps/payment-service/src/index.ts"]
