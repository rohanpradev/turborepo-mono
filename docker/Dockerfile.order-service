# syntax=docker/dockerfile:1.27.0@sha256:bde3983e9c939224420ddaf6b784cc30e09b035a4dea01f581230c50809f372e
ARG BUN_DEV_IMAGE=oven/bun:1.4.3@sha256:ec06c3b6cea04192ae6770c434f668ca41d343ad19fa6472216c7b48be39c598
ARG BUN_RUNTIME_IMAGE=oven/bun:1.4.3@sha256:ec06c3b6cea04192ae6770c434f668ca41d343ad19fa6472216c7b48be39c598
ARG TURBO_VERSION=2.11.7

FROM ${BUN_DEV_IMAGE} AS pruner
ARG TURBO_VERSION
ENV CI=1 \
    TURBO_TELEMETRY_DISABLED=1
WORKDIR /repo
RUN --mount=type=cache,target=/root/.bun/install/cache,sharing=locked \
    bun install --global turbo@${TURBO_VERSION}
ENV PATH="/root/.bun/bin:$PATH"
COPY --link . .
RUN turbo prune order-service --docker

FROM ${BUN_DEV_IMAGE} AS prod-deps
ENV CI=1 \
    TURBO_TELEMETRY_DISABLED=1 \
    NODE_ENV=production
WORKDIR /app

COPY --link --from=pruner /repo/out/json/ ./
RUN --mount=type=cache,target=/root/.bun/install/cache,sharing=locked \
    bun install --frozen-lockfile --production --linker=hoisted

FROM ${BUN_DEV_IMAGE} AS builder
ENV CI=1 \
    TURBO_TELEMETRY_DISABLED=1 \
    NODE_ENV=production
WORKDIR /app

COPY --link --from=pruner /repo/out/json/ ./
RUN --mount=type=cache,target=/root/.bun/install/cache,sharing=locked \
    bun install --frozen-lockfile --linker=hoisted
COPY --link --from=pruner /repo/out/full/ ./
RUN bun run --cwd apps/order-service check-types

FROM ${BUN_RUNTIME_IMAGE} AS runner
ENV NODE_ENV=production \
    BUN_RUNTIME_TRANSPILER_CACHE_PATH=/tmp/bun-transpiler \
    NODE_PATH=/app/node_modules/.bun/node_modules \
    PORT=8001
WORKDIR /app

COPY --link --from=prod-deps /app/node_modules ./node_modules
COPY --link --from=builder /app/package.json ./package.json
COPY --link --from=builder /app/bun.lock ./bun.lock

# Preserve workspace-local production dependencies as well as the root tree.
COPY --link --from=prod-deps /app/apps/order-service ./apps/order-service
COPY --link --from=builder /app/apps/order-service/package.json ./apps/order-service/package.json
COPY --link --from=builder /app/apps/order-service/tsconfig.json ./apps/order-service/tsconfig.json
COPY --link --from=builder /app/apps/order-service/src ./apps/order-service/src

# Source comes from the pruned context; dependency links come only from prod-deps.
COPY --link --from=pruner /repo/out/full/packages ./packages
COPY --link --from=prod-deps /app/packages ./packages

USER bun

EXPOSE 8001

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD ["bun", "-e", "fetch('http://127.0.0.1:8001/health/ready', { signal: AbortSignal.timeout(3000), proxy: false }).then((response) => { if (!response.ok) process.exit(1); }).catch(() => process.exit(1));"]
STOPSIGNAL SIGTERM

CMD ["bun", "run", "apps/order-service/src/index.ts"]
