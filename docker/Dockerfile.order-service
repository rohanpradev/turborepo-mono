# syntax=docker/dockerfile:1.24.0@sha256:87999aa3d42bdc6bea60565083ee17e86d1f3339802f543c0d03998580f9cb89
ARG BUN_DEV_IMAGE=dhi.io/bun:1.3.14-debian13-dev@sha256:294098cbf9ef24c7c66cb5849ea0c998fef17245d9aa3d955c078a73ccbada89
ARG BUN_RUNTIME_IMAGE=dhi.io/bun:1.3.14-debian13@sha256:fb5dda72d73bd1e581d014e6546352766f8565bb78ce66a290e4f11fdc188c11
ARG TURBO_VERSION=2.10.5

FROM ${BUN_DEV_IMAGE} AS pruner
ENV CI=1 \
    TURBO_TELEMETRY_DISABLED=1
WORKDIR /repo
RUN --mount=type=cache,target=/root/.bun/install/cache,sharing=locked \
    bun install --global turbo@${TURBO_VERSION}
ENV PATH="/root/.bun/bin:$PATH"
COPY --link . .
RUN turbo prune order-service --docker

FROM ${BUN_DEV_IMAGE} AS builder
ENV CI=1 \
    TURBO_TELEMETRY_DISABLED=1 \
    NODE_ENV=production
WORKDIR /app

COPY --link --from=pruner /repo/out/json/ ./
RUN --mount=type=cache,target=/root/.bun/install/cache,sharing=locked \
    bun install --frozen-lockfile --production --linker=hoisted
COPY --link --from=pruner /repo/out/full/ ./

FROM ${BUN_RUNTIME_IMAGE} AS runner
ENV NODE_ENV=production \
    NODE_PATH=/app/node_modules/.bun/node_modules \
    PORT=8001
WORKDIR /app

COPY --link --from=builder /app/node_modules ./node_modules
COPY --link --from=builder /app/package.json ./package.json
COPY --link --from=builder /app/bun.lock ./bun.lock

COPY --link --from=builder /app/apps/order-service/package.json ./apps/order-service/package.json
COPY --link --from=builder /app/apps/order-service/tsconfig.json ./apps/order-service/tsconfig.json
COPY --link --from=builder /app/apps/order-service/src ./apps/order-service/src

COPY --link --from=builder /app/packages ./packages

EXPOSE 8001

CMD ["bun", "run", "apps/order-service/src/index.ts"]
