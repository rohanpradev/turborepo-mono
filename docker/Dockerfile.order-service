# syntax=docker/dockerfile:1
ARG BUN_DEV_IMAGE=dhi.io/bun:1-debian13-dev
ARG BUN_RUNTIME_IMAGE=dhi.io/bun:1-debian13
ARG TURBO_VERSION=2.9.14

FROM ${BUN_DEV_IMAGE} AS pruner
ENV CI=1 \
    TURBO_TELEMETRY_DISABLED=1
WORKDIR /repo
RUN --mount=type=cache,target=/root/.bun/install/cache,sharing=locked \
    bun install --global turbo@${TURBO_VERSION}
ENV PATH="/root/.bun/bin:$PATH"
COPY --link . .
RUN turbo prune order-service --docker

FROM ${BUN_DEV_IMAGE} AS builder
ENV CI=1 \
    TURBO_TELEMETRY_DISABLED=1 \
    NODE_ENV=production
WORKDIR /app

COPY --link --from=pruner /repo/out/json/ ./
RUN --mount=type=cache,target=/root/.bun/install/cache,sharing=locked \
    bun install --frozen-lockfile --production --linker=hoisted
COPY --link --from=pruner /repo/out/full/ ./

FROM ${BUN_RUNTIME_IMAGE} AS runner
ENV NODE_ENV=production \
    NODE_PATH=/app/node_modules/.bun/node_modules \
    PORT=8001
WORKDIR /app

COPY --link --from=builder /app/node_modules ./node_modules
COPY --link --from=builder /app/package.json ./package.json
COPY --link --from=builder /app/bun.lock ./bun.lock
COPY --link --from=builder /app/apps/order-service/package.json ./apps/order-service/package.json
COPY --link --from=builder /app/apps/order-service/tsconfig.json ./apps/order-service/tsconfig.json
COPY --link --from=builder /app/apps/order-service/src ./apps/order-service/src
COPY --link --from=builder /app/packages/hono-utils/package.json ./packages/hono-utils/package.json
COPY --link --from=builder /app/packages/hono-utils/src ./packages/hono-utils/src
COPY --link --from=builder /app/packages/kafka/package.json ./packages/kafka/package.json
COPY --link --from=builder /app/packages/kafka/src ./packages/kafka/src
COPY --link --from=builder /app/packages/order-db/package.json ./packages/order-db/package.json
COPY --link --from=builder /app/packages/order-db/src ./packages/order-db/src
COPY --link --from=builder /app/packages/types/package.json ./packages/types/package.json
COPY --link --from=builder /app/packages/types/src ./packages/types/src
COPY --link --from=builder /app/packages/typescript-config ./packages/typescript-config

EXPOSE 8001

CMD ["bun", "run", "apps/order-service/src/index.ts"]
