# syntax=docker/dockerfile:1.26.0@sha256:ecfaec9ed6d810b56388c508f4121597bfbba70d41a6dfeee4d8cad5f295fc32
ARG BUN_DEV_IMAGE=oven/bun:1.4.0@sha256:5ff609364c049b54eb0ff560ec96319729a972078ef2c755d758f0c6ef89c2d6
ARG BUN_RUNTIME_IMAGE=oven/bun:1.4.0@sha256:5ff609364c049b54eb0ff560ec96319729a972078ef2c755d758f0c6ef89c2d6
ARG TURBO_VERSION=2.10.12

FROM ${BUN_DEV_IMAGE} AS pruner
ARG TURBO_VERSION
ENV CI=1 \
    TURBO_TELEMETRY_DISABLED=1 \
    NEXT_TELEMETRY_DISABLED=1
WORKDIR /repo
RUN --mount=type=cache,target=/root/.bun/install/cache,sharing=locked \
    bun install --global turbo@${TURBO_VERSION}
ENV PATH="/root/.bun/bin:$PATH"
COPY --link . .
RUN turbo prune admin --docker

FROM ${BUN_DEV_IMAGE} AS builder
ARG TURBO_VERSION
ENV CI=1 \
    TURBO_TELEMETRY_DISABLED=1 \
    NEXT_TELEMETRY_DISABLED=1
RUN --mount=type=cache,target=/root/.bun/install/cache,sharing=locked \
    bun install --global turbo@${TURBO_VERSION}
ENV PATH="/root/.bun/bin:$PATH"
WORKDIR /app

ARG NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
ARG NEXT_PUBLIC_ADMIN_APP_URL=""
ARG NEXT_PUBLIC_CLIENT_APP_URL=""
ARG NEXT_IMAGE_STOREFRONT_ORIGIN="http://client:3002"
ARG NEXT_IMAGE_ALLOW_LOCAL_IP="false"
ARG NEXT_PUBLIC_PRODUCT_SERVICE_URL="https://api.localhost"
ARG NEXT_PUBLIC_ORDER_SERVICE_URL="https://api.localhost"
ARG NEXT_PUBLIC_PAYMENT_SERVICE_URL="https://api.localhost"
ARG NEXT_DEPLOYMENT_ID=""

ENV NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=${NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY} \
    NEXT_PUBLIC_ADMIN_APP_URL=${NEXT_PUBLIC_ADMIN_APP_URL} \
    NEXT_PUBLIC_CLIENT_APP_URL=${NEXT_PUBLIC_CLIENT_APP_URL} \
    NEXT_IMAGE_STOREFRONT_ORIGIN=${NEXT_IMAGE_STOREFRONT_ORIGIN} \
    NEXT_IMAGE_ALLOW_LOCAL_IP=${NEXT_IMAGE_ALLOW_LOCAL_IP} \
    NEXT_PUBLIC_PRODUCT_SERVICE_URL=${NEXT_PUBLIC_PRODUCT_SERVICE_URL} \
    NEXT_PUBLIC_ORDER_SERVICE_URL=${NEXT_PUBLIC_ORDER_SERVICE_URL} \
    NEXT_PUBLIC_PAYMENT_SERVICE_URL=${NEXT_PUBLIC_PAYMENT_SERVICE_URL} \
    NEXT_DEPLOYMENT_ID=${NEXT_DEPLOYMENT_ID}

COPY --link --from=pruner /repo/out/json/ ./
RUN --mount=type=cache,target=/root/.bun/install/cache,sharing=locked \
    bun install --frozen-lockfile --linker=hoisted
COPY --link --from=pruner /repo/out/full/ ./
RUN turbo run build --filter=admin...

FROM ${BUN_RUNTIME_IMAGE} AS runner
ENV NODE_ENV=production \
    PORT=3003 \
    HOSTNAME=0.0.0.0 \
    NEXT_TELEMETRY_DISABLED=1
WORKDIR /app

COPY --link --from=builder /app/apps/admin/.next/standalone ./
COPY --link --from=builder /app/apps/admin/.next/static ./apps/admin/.next/static
COPY --link --from=builder /app/apps/admin/public ./apps/admin/public

USER bun

EXPOSE 3003

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD ["bun", "-e", "fetch('http://127.0.0.1:3003/api/health').then((response) => { if (!response.ok) process.exit(1); }).catch(() => process.exit(1));"]
STOPSIGNAL SIGTERM

CMD ["bun", "apps/admin/server.js"]
