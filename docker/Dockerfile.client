# syntax=docker/dockerfile:1.27.0@sha256:bde3983e9c939224420ddaf6b784cc30e09b035a4dea01f581230c50809f372e
ARG BUN_DEV_IMAGE=oven/bun:1.4.2@sha256:9114c058aeae42162ee16dd5084b95fe9473970bb6bcb5b232ab1630f0546895
ARG BUN_RUNTIME_IMAGE=oven/bun:1.4.2@sha256:9114c058aeae42162ee16dd5084b95fe9473970bb6bcb5b232ab1630f0546895
ARG TURBO_VERSION=2.11.7

FROM ${BUN_DEV_IMAGE} AS pruner
ARG TURBO_VERSION
ENV CI=1 \
    TURBO_TELEMETRY_DISABLED=1 \
    NEXT_TELEMETRY_DISABLED=1
WORKDIR /repo
RUN --mount=type=cache,target=/root/.bun/install/cache,sharing=locked \
    bun install --global turbo@${TURBO_VERSION}
ENV PATH="/root/.bun/bin:$PATH"
COPY --link . .
RUN turbo prune client --docker

FROM ${BUN_DEV_IMAGE} AS builder
ARG TURBO_VERSION
ENV CI=1 \
    TURBO_TELEMETRY_DISABLED=1 \
    NEXT_TELEMETRY_DISABLED=1
RUN --mount=type=cache,target=/root/.bun/install/cache,sharing=locked \
    bun install --global turbo@${TURBO_VERSION}
ENV PATH="/root/.bun/bin:$PATH"
WORKDIR /app

ARG NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
ARG NEXT_PUBLIC_CLIENT_APP_URL=""
ARG NEXT_PUBLIC_PRODUCT_SERVICE_URL="https://api.localhost"
ARG NEXT_PUBLIC_ORDER_SERVICE_URL="https://api.localhost"
ARG NEXT_PUBLIC_PAYMENT_SERVICE_URL="https://api.localhost"
ARG NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
ARG NEXT_IMAGE_ALLOW_LOCAL_IP="false"
ARG NEXT_PUBLIC_IMAGE_REMOTE_HOSTS=""
ARG NEXT_DEPLOYMENT_ID=""

ENV NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=${NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY} \
    NEXT_PUBLIC_CLIENT_APP_URL=${NEXT_PUBLIC_CLIENT_APP_URL} \
    NEXT_PUBLIC_PRODUCT_SERVICE_URL=${NEXT_PUBLIC_PRODUCT_SERVICE_URL} \
    NEXT_PUBLIC_ORDER_SERVICE_URL=${NEXT_PUBLIC_ORDER_SERVICE_URL} \
    NEXT_PUBLIC_PAYMENT_SERVICE_URL=${NEXT_PUBLIC_PAYMENT_SERVICE_URL} \
    NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=${NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY} \
    NEXT_IMAGE_ALLOW_LOCAL_IP=${NEXT_IMAGE_ALLOW_LOCAL_IP} \
    NEXT_PUBLIC_IMAGE_REMOTE_HOSTS=${NEXT_PUBLIC_IMAGE_REMOTE_HOSTS} \
    NEXT_DEPLOYMENT_ID=${NEXT_DEPLOYMENT_ID}

COPY --link --from=pruner /repo/out/json/ ./
RUN --mount=type=cache,target=/root/.bun/install/cache,sharing=locked \
    bun install --frozen-lockfile --linker=hoisted
COPY --link --from=pruner /repo/out/full/ ./
RUN --mount=type=cache,id=nextjs-client,target=/app/apps/client/.next/cache,sharing=locked \
    turbo run build --filter=client...

FROM ${BUN_RUNTIME_IMAGE} AS runner
ENV NODE_ENV=production \
    PORT=3002 \
    HOSTNAME=0.0.0.0 \
    NEXT_TELEMETRY_DISABLED=1
WORKDIR /app

COPY --link --from=builder /app/apps/client/.next/standalone ./
COPY --link --from=builder /app/apps/client/.next/static ./apps/client/.next/static
COPY --link --from=builder /app/apps/client/public ./apps/client/public

USER bun

EXPOSE 3002

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD ["bun", "-e", "fetch('http://127.0.0.1:3002/api/health').then((response) => { if (!response.ok) process.exit(1); }).catch(() => process.exit(1));"]
STOPSIGNAL SIGTERM

CMD ["bun", "apps/client/server.js"]
