{
  "tags": ["app:web"],
  "extends": ["//"],
  "tasks": {
    "build": {
      "dependsOn": ["$TURBO_EXTENDS$"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [
        "$TURBO_EXTENDS$",
        ".next/**",
        "!.next/cache/**",
        "!.next/dev/**"
      ],
      "env": [
        "ADMIN_APP_URL",
        "CLIENT_APP_URL",
        "NEXT_DEPLOYMENT_ID",
        "NEXT_IMAGE_ALLOW_LOCAL_IP",
        "NEXT_IMAGE_STOREFRONT_ORIGIN",
        "NEXT_PUBLIC_*",
        "ORDER_SERVICE_INTERNAL_URL",
        "PAYMENT_SERVICE_INTERNAL_URL",
        "PRODUCT_SERVICE_INTERNAL_URL",
        "STOREFRONT_ASSET_ORIGIN"
      ],
      "passThroughEnv": [
        "ADMIN_USER_IDS",
        "CLERK_AUTHORIZED_PARTIES",
        "CLERK_JWT_KEY",
        "CLERK_PUBLISHABLE_KEY",
        "CLERK_SECRET_KEY",
        "NEXT_TELEMETRY_DISABLED"
      ]
    },
    "check-types": {
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "env": [
        "ADMIN_APP_URL",
        "CLIENT_APP_URL",
        "NEXT_DEPLOYMENT_ID",
        "NEXT_IMAGE_ALLOW_LOCAL_IP",
        "NEXT_IMAGE_STOREFRONT_ORIGIN",
        "NEXT_PUBLIC_*",
        "ORDER_SERVICE_INTERNAL_URL",
        "PAYMENT_SERVICE_INTERNAL_URL",
        "PRODUCT_SERVICE_INTERNAL_URL",
        "STOREFRONT_ASSET_ORIGIN"
      ],
      "passThroughEnv": [
        "ADMIN_USER_IDS",
        "CLERK_AUTHORIZED_PARTIES",
        "CLERK_JWT_KEY",
        "CLERK_PUBLISHABLE_KEY",
        "CLERK_SECRET_KEY",
        "NEXT_TELEMETRY_DISABLED"
      ]
    }
  }
}
