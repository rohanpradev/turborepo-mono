{
  "extends": ["//"],
  "tasks": {
    "build": {
      "dependsOn": ["$TURBO_EXTENDS$"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**"],
      "env": [
        "ADMIN_APP_URL",
        "CLIENT_APP_URL",
        "NEXT_PUBLIC_*",
        "ORDER_SERVICE_INTERNAL_URL",
        "PAYMENT_SERVICE_INTERNAL_URL",
        "PRODUCT_SERVICE_INTERNAL_URL"
      ]
    },
    "check-types": {
      "outputs": [".next/types/**", ".next/dev/types/**"]
    }
  }
}
